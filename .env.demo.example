# Variables de entorno para la Demo en Vercel
# ============================================================
# Configura estas variables en Vercel → Settings → Environment Variables
# para desplegar la demo pública sin necesitar Supabase ni base de datos.
# ============================================================

NEXT_PUBLIC_IS_DEMO=true

# Supabase vacío → modo mock automático (datos de ejemplo en memoria)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin demo: usuario admin, contraseña admin (solo para demo)
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# JWT Secret para sesiones de demo
JWT_SECRET=demo-secret-techhub-not-for-production

# URL base de la demo
NEXT_PUBLIC_SITE_URL=https://plantilla-blog-monetizable-demo.vercel.app

# AdSense y Brevo desactivados en demo (dejar vacíos)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_TOP_SLOT=
NEXT_PUBLIC_ADSENSE_BOTTOM_SLOT=
BREVO_API_KEY=
